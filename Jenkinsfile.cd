def runCommand(String command, boolean capture = false) {
    if (isUnix()) {
        return sh(script: command, returnStdout: capture)
    }
    return bat(script: "@${command}", returnStdout: capture)
}

pipeline {
    agent any

    options {
        skipDefaultCheckout()
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'BUILD_NUMBER', defaultValue: '',
               description: 'Successful CI-React-App build number')
        choice(name: 'ENVIRONMENT', choices: ['DEV', 'TEST', 'ACC', 'PROD'],
               description: 'Deployment environment')
    }

    stages {
        stage('Download Artifact') {
            steps {
                script {
                    def ciBuild = params.BUILD_NUMBER.trim()
                    if (!(ciBuild ==~ /[1-9][0-9]*/)) {
                        error('Enter a successful CI-React-App build number.')
                    }

                    def ports = [DEV: '8081', TEST: '8082', ACC: '8083', PROD: '8084']
                    def target = params.ENVIRONMENT.toLowerCase()

                    env.ARCHIVE_NAME = "react-app-${ciBuild}.tar.gz"
                    env.APP_IMAGE = "react-app:${target}-${ciBuild}"
                    env.APP_CONTAINER = "react-app-${target}"
                    env.APP_PORT = ports[params.ENVIRONMENT]

                    dir('deploy') {
                        deleteDir()
                    }

                    copyArtifacts(
                        projectName: 'CI-React-App',
                        selector: specific(ciBuild),
                        filter: env.ARCHIVE_NAME,
                        target: 'deploy'
                    )
                }
            }
        }

        stage('Prepare Files') {
            steps {
                dir('deploy') {
                    script {
                        runCommand('mkdir context')
                        runCommand("tar -xzf ${env.ARCHIVE_NAME} -C context")
                    }
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                script {
                    runCommand("docker build -t ${env.APP_IMAGE} deploy/context")
                }
            }
        }

        stage('Deploy to Docker') {
            steps {
                script {
                    def containers = runCommand(
                        'docker ps -a --format "{{.Names}}"', true
                    ).readLines()

                    if (containers.contains(env.APP_CONTAINER)) {
                        runCommand("docker rm -f ${env.APP_CONTAINER}")
                    }

                    runCommand(
                        "docker run -d --name ${env.APP_CONTAINER} " +
                        "-p 127.0.0.1:${env.APP_PORT}:80 ${env.APP_IMAGE}"
                    )
                    runCommand("docker ps --filter name=${env.APP_CONTAINER}")
                }
            }
        }
    }
}